    {
      "id": "integration-benchmark",
      "command": "python -B -m unittest -q tests.test_integration_gate tests.test_parallel_benchmark"
    }
  ],
  "warmup_repetitions_per_workstream": 1,
  "measurement_batches": 3,
  "repetitions_per_batch_per_workstream": 10,
  "sequential_mode": "within each measured repetition, run workstream 1 to completion then workstream 2 to completion",
  "parallel_mode": "within each measured repetition, launch the two workstreams concurrently and wait for both to complete",
  "timer": "time.perf_counter()",
  "acceptance": {
    "parallel_elapsed_less_than_sequential": true,
    "parallel_unresolved_conflicts_lte_baseline": true,
    "parallel_rollbacks_lte_baseline": true,
    "all_invocations_must_pass": true
  }
